package main

import (
	"context"
	"database/sql"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"time"

	"github.com/agilira/zephyros"
)

// Example 1: Simple Text Processing
type TextProcessor struct{}

func (tp *TextProcessor) Process(ctx context.Context, op zephyros.Operation) (zephyros.OperationResult, error) {
	// Simulate processing time
	time.Sleep(10 * time.Millisecond)

	result := fmt.Sprintf("Processed: %s -> %s", op.Key, op.Value)
	return zephyros.OperationResult{
		OperationID: op.ID,
		Success:     true,
		Data:        result,
		Duration:    time.Millisecond,
	}, nil
}

// Example 2: Database Handler
type DatabaseHandler struct {
	db *sql.DB
}

func (dh *DatabaseHandler) Process(ctx context.Context, op zephyros.Operation) (zephyros.OperationResult, error) {
	var result string
	err := dh.db.QueryRowContext(ctx, "SELECT data FROM items WHERE key = ?", op.Key).Scan(&result)
	if err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}

	return zephyros.OperationResult{
		OperationID: op.ID,
		Success:     true,
		Data:        result,
	}, nil
}

// Example 3: HTTP API Handler
type APIHandler struct {
	client  *http.Client
	baseURL string
}

func (ah *APIHandler) Process(ctx context.Context, op zephyros.Operation) (zephyros.OperationResult, error) {
	url := fmt.Sprintf("%s/api/%s", ah.baseURL, op.Key)

	req, err := http.NewRequestWithContext(ctx, "GET", url, nil)
	if err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}

	resp, err := ah.client.Do(req)
	if err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}

	return zephyros.OperationResult{
		OperationID: op.ID,
		Success:     true,
		Data:        string(body),
	}, nil
}

// Example 4: JSON Processing Handler
type JSONProcessor struct{}

func (jp *JSONProcessor) Process(ctx context.Context, op zephyros.Operation) (zephyros.OperationResult, error) {
	// Parse JSON input
	var input map[string]interface{}
	if err := json.Unmarshal([]byte(op.Value), &input); err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}

	// Process the JSON data
	input["processed"] = true
	input["timestamp"] = time.Now().Unix()

	// Convert back to JSON
	output, err := json.Marshal(input)
	if err != nil {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       err,
		}, err
	}

	return zephyros.OperationResult{
		OperationID: op.ID,
		Success:     true,
		Data:        string(output),
	}, nil
}

// Example 5: Error Handler
type ErrorHandler struct{}

func (eh *ErrorHandler) Process(ctx context.Context, op zephyros.Operation) (zephyros.OperationResult, error) {
	// Simulate different error conditions
	if op.Key == "error" {
		return zephyros.OperationResult{
			OperationID: op.ID,
			Success:     false,
			Error:       fmt.Errorf("simulated error for key: %s", op.Key),
		}, fmt.Errorf("simulated error for key: %s", op.Key)
	}

	if op.Key == "panic" {
		panic("simulated panic")
	}

	return zephyros.OperationResult{
		OperationID: op.ID,
		Success:     true,
		Data:        fmt.Sprintf("Successfully processed: %s", op.Value),
	}, nil
}

func main() {
	// Example 1: Basic Text Processing
	fmt.Println("=== Example 1: Basic Text Processing ===")
	basicExample()

	// Example 2: Batch Processing
	fmt.Println("\n=== Example 2: Batch Processing ===")
	batchExample()

	// Example 3: Caching
	fmt.Println("\n=== Example 3: Caching ===")
	cachingExample()

	// Example 4: Error Handling
	fmt.Println("\n=== Example 4: Error Handling ===")
	errorHandlingExample()

	// Example 5: Metrics Monitoring
	fmt.Println("\n=== Example 5: Metrics Monitoring ===")
	metricsExample()
}

func basicExample() {
	config := zephyros.PoolConfig{
		WorkerCount:   2,
		QueueSize:     100,
		EnableMetrics: true,
	}

	pool, err := zephyros.NewOperationPool(config, &TextProcessor{})
	if err != nil {
		log.Fatal(err)
	}
	defer pool.Close()

	ctx := context.Background()

	// Submit operations
	for i := 0; i < 5; i++ {
		op := zephyros.Operation{
			Type:  "text_process",
			Key:   fmt.Sprintf("key_%d", i),
			Value: fmt.Sprintf("value_%d", i),
		}

		if err := pool.Submit(ctx, op); err != nil {
			log.Printf("Submit error: %v", err)
		}
	}

	// Get results
	for i := 0; i < 5; i++ {
		result, err := pool.GetResult(ctx)
		if err != nil {
			log.Printf("Get result error: %v", err)
			continue
		}

		fmt.Printf("Result: %v\n", result.Data)
	}

	metrics := pool.GetMetrics()
	fmt.Printf("Metrics: processed=%d, failed=%d\n", metrics.ProcessedOps, metrics.FailedOps)
}

func batchExample() {
	config := zephyros.PoolConfig{
		WorkerCount: 4,
		QueueSize:   1000,
		BatchConfig: zephyros.BatchConfig{
			EnableBatchProcessing: true,
			BatchSize:             5,
			BatchTimeout:          50 * time.Millisecond,
			FlushInterval:         25 * time.Millisecond,
		},
		EnableMetrics: true,
	}

	pool, err := zephyros.NewOperationPool(config, &TextProcessor{})
	if err != nil {
		log.Fatal(err)
	}
	defer pool.Close()

	ctx := context.Background()

	// Submit operations in batches
	for i := 0; i < 20; i++ {
		op := zephyros.Operation{
			Type:  "batch_process",
			Key:   fmt.Sprintf("batch_key_%d", i),
			Value: fmt.Sprintf("batch_value_%d", i),
		}

		if err := pool.Submit(ctx, op); err != nil {
			log.Printf("Batch submit error: %v", err)
		}
	}

	// Get results
	for i := 0; i < 20; i++ {
		result, err := pool.GetResult(ctx)
		if err != nil {
			log.Printf("Get result error: %v", err)
			continue
		}

		fmt.Printf("Batch Result: %v\n", result.Data)
	}

	metrics := pool.GetMetrics()
	fmt.Printf("Batch Metrics: processed=%d, failed=%d\n", metrics.ProcessedOps, metrics.FailedOps)
}

func cachingExample() {
	config := zephyros.PoolConfig{
		WorkerCount: 2,
		QueueSize:   500,
		CacheConfig: zephyros.CacheConfig{
			EnableCaching:   true,
			CacheSize:       1000,
			TTL:             5 * time.Minute,
			CleanupInterval: 1 * time.Minute,
		},
		EnableMetrics: true,
	}

	pool, err := zephyros.NewOperationPool(config, &TextProcessor{})
	if err != nil {
		log.Fatal(err)
	}
	defer pool.Close()

	ctx := context.Background()

	// Submit operations with the same key (will be cached)
	for i := 0; i < 3; i++ {
		op := zephyros.Operation{
			Type:  "cached_process",
			Key:   "same_key", // This will be cached after first request
			Value: "same_value",
		}

		if err := pool.Submit(ctx, op); err != nil {
			log.Printf("Cache submit error: %v", err)
		}
	}

	// Get results
	for i := 0; i < 3; i++ {
		result, err := pool.GetResult(ctx)
		if err != nil {
			log.Printf("Get result error: %v", err)
			continue
		}

		fmt.Printf("Cache Result: %v\n", result.Data)
	}

	// Get cache statistics
	cacheStats := pool.GetCacheStats()
	fmt.Printf("Cache Stats: size=%d/%d, total_access=%d, avg_access=%.2f\n",
		cacheStats.Size, cacheStats.MaxSize, cacheStats.TotalAccessCount, float64(cacheStats.AverageAccessCount))
}

func errorHandlingExample() {
	config := zephyros.PoolConfig{
		WorkerCount:   2,
		QueueSize:     100,
		EnableMetrics: true,
	}

	pool, err := zephyros.NewOperationPool(config, &ErrorHandler{})
	if err != nil {
		log.Fatal(err)
	}
	defer pool.Close()

	ctx := context.Background()

	// Submit operations with different scenarios
	operations := []zephyros.Operation{
		{Type: "error_test", Key: "normal", Value: "normal operation"},
		{Type: "error_test", Key: "error", Value: "this will cause an error"},
		{Type: "error_test", Key: "panic", Value: "this will cause a panic"},
		{Type: "error_test", Key: "normal2", Value: "another normal operation"},
	}

	for _, op := range operations {
		if err := pool.Submit(ctx, op); err != nil {
			log.Printf("Submit error: %v", err)
		}
	}

	// Get results
	for i := 0; i < len(operations); i++ {
		result, err := pool.GetResult(ctx)
		if err != nil {
			log.Printf("Get result error: %v", err)
			continue
		}

		if result.Success {
			fmt.Printf("Success: %v\n", result.Data)
		} else {
			fmt.Printf("Error: %v\n", result.Error)
		}
	}

	metrics := pool.GetMetrics()
	fmt.Printf("Error Handling Metrics: processed=%d, failed=%d\n", metrics.ProcessedOps, metrics.FailedOps)
}

func metricsExample() {
	config := zephyros.PoolConfig{
		WorkerCount:   3,
		QueueSize:     200,
		EnableMetrics: true,
	}

	pool, err := zephyros.NewOperationPool(config, &TextProcessor{})
	if err != nil {
		log.Fatal(err)
	}
	defer pool.Close()

	// Start metrics monitoring in a separate goroutine
	done := make(chan bool)
	go func() {
		ticker := time.NewTicker(100 * time.Millisecond)
		defer ticker.Stop()

		for i := 0; i < 5; i++ {
			<-ticker.C
			metrics := pool.GetMetrics()
			cacheStats := pool.GetCacheStats()

			fmt.Printf("Metrics Update %d:\n", i+1)
			fmt.Printf("  Pool: workers=%d, queue=%d, processed=%d, failed=%d\n",
				metrics.ActiveWorkers, metrics.QueueLength, metrics.ProcessedOps, metrics.FailedOps)
			fmt.Printf("  Cache: size=%d/%d, total_access=%d, avg_access=%.2f\n",
				cacheStats.Size, cacheStats.MaxSize, cacheStats.TotalAccessCount, float64(cacheStats.AverageAccessCount))
		}
		done <- true
	}()

	ctx := context.Background()

	// Submit operations while monitoring
	for i := 0; i < 10; i++ {
		op := zephyros.Operation{
			Type:  "metrics_test",
			Key:   fmt.Sprintf("metrics_key_%d", i),
			Value: fmt.Sprintf("metrics_value_%d", i),
		}

		if err := pool.Submit(ctx, op); err != nil {
			log.Printf("Submit error: %v", err)
		}

		time.Sleep(50 * time.Millisecond)
	}

	// Get results
	for i := 0; i < 10; i++ {
		result, err := pool.GetResult(ctx)
		if err != nil {
			log.Printf("Get result error: %v", err)
			continue
		}

		fmt.Printf("Metrics Result: %v\n", result.Data)
	}

	<-done // Wait for metrics monitoring to complete

	// Final metrics
	finalMetrics := pool.GetMetrics()
	fmt.Printf("Final Metrics: processed=%d, failed=%d, avg_duration=%v\n",
		finalMetrics.ProcessedOps, finalMetrics.FailedOps, finalMetrics.AverageDuration)
}
